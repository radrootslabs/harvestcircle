{
  "name": "harvestcircle_web",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.9.1"
  },
  "scripts": {
    "dev": "node tools/check-source.mjs && vite",
    "build": "node tools/check-source.mjs && node tools/build-info.mjs && vite build && node tools/check-output.mjs",
    "check": "node tools/check-source.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "node tools/check-source.mjs && svelte-kit sync && eslint . --max-warnings 0 && prettier --check .",
    "test:unit": "node tools/check-source.mjs && svelte-kit sync && vitest run --config vitest.config.ts && node --test --test-concurrency=1 --test-timeout=10000 tests/provenance/*.test.mjs",
    "test:conformance": "corepack pnpm build && node --test tests/conformance/*.test.ts",
    "test:integration": "corepack pnpm build && node --test --test-timeout=10000 tests/integration/*.test.ts",
    "test:e2e": "corepack pnpm build && playwright test",
    "test:conformance:oracle": "node tools/check-food-interop.mjs",
    "check:launch-relays": "node tools/check-source.mjs && node tools/check-launch-relays.mjs"
  },
  "dependencies": {
    "@noble/curves": "1.2.0",
    "@scure/base": "1.1.1",
    "applesauce-core": "6.2.0",
    "applesauce-relay": "6.2.1",
    "applesauce-signers": "6.2.3",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@opentelemetry/api": "1.9.1",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.0.0",
    "@sveltejs/load-config": "0.2.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.1",
    "@types/ws": "8.18.2",
    "eslint": "10.12.0",
    "eslint-plugin-svelte": "3.23.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "ws": "8.22.0"
  }
}
